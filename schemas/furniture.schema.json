{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/personal-twin/furniture.schema.json",
  "title": "Personal Twin Furniture Layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "spaceId", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "spaceId": { "type": "string", "minLength": 1 },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "dimensions", "transform"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["desk", "chair", "bed", "wardrobe", "shelf", "storage", "other"] },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "depth", "height"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z", "rotationZ"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" },
            "rotationZ": { "type": "number" }
          }
        },
        "clearance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "front": { "type": "number", "minimum": 0 },
            "back": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "sku": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
